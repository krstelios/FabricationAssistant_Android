<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>FabricationAssistant.App.Android.Tests</RootNamespace>
    <AssemblyName>FabricationAssistant.App.Android.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Test project targets plain net8.0 (overridden by local Directory.Build.props),
    not net8.0-android. This lets pure math/gesture/import tests run on the dev
    machine via `dotnet test` without needing an emulator. We link the math
    subset of Core directly so the tests are self-contained.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Math\**\*.cs"
             LinkBase="Linked\Math" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Camera\CameraState.cs"
             LinkBase="Linked\Camera" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Camera\StandardView.cs"
             LinkBase="Linked\Camera" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\MeshDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Sections\SectionPlane.cs"
             LinkBase="Linked\Sections" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Sections\SectionPlaneSnapshot.cs"
             LinkBase="Linked\Sections" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Sections\SectionCapGeometry.cs"
             LinkBase="Linked\Sections" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Sections\SectionService.cs"
             LinkBase="Linked\Sections" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\UndoRedo\ISectionStateAccess.cs"
             LinkBase="Linked\UndoRedo" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Selection\PackageSessionState.cs"
             LinkBase="Linked\Selection" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\BodyMove\BodyMoveSnapshot.cs"
             LinkBase="Linked\BodyMove" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Domain\*.cs"
             LinkBase="Linked\Measurement\Domain" />
    <!-- MeshMeasurePicker + its host-safe Core deps (Task 1).
         Note: MeasurementSession/MeasureTool/BoundingBoxService/OrientedBoxSolver
         pull in the full UndoRedo+Selection+BodyMove stack; they are omitted here
         and deferred to the task that first needs them in a test. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\MeshMeasurePicker.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\IMeasurementPicker.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\IMeasureRaycaster.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\PickTypes.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\FaceDetectionService.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\FacePatch.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\FeatureEdgeExtractor.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Engine\SectionMeasureGeometryProvider.cs"
             LinkBase="Linked\Measurement\Engine" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\Measurement\Presentation\Primitives.cs"
             LinkBase="Linked\Measurement\Presentation" />
    <!-- SceneNode (needed by IMeasureRaycaster.GetNode) + its transitive SceneGraph closure -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\SceneNode.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\SceneNodeType.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\SceneNodeDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\SceneNodeMetadataDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\ScenePropertyDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\Scene.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\ScenePackageInfoDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\MaterialDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\ImportStatsDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\DocumentDto.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Core\SceneGraph\SceneBoundsUtilities.cs"
             LinkBase="Linked\SceneGraph" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Core.Android\Measurement\Engine\EdgeSnapService.cs"
             LinkBase="Linked\Core.Android.Measurement.Engine" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\AndroidViewerStateSaveService.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\Internal\FaArchiveCredential.cs"
             LinkBase="Linked\Import\Internal" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\FaArchive.cs"
             LinkBase="Linked\Import" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\FaArchiveLimits.cs"
             LinkBase="Linked\Import" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\FaArchiveManifest.cs"
             LinkBase="Linked\Import" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\FaArchiveManifestMutator.cs"
             LinkBase="Linked\Import" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\FaArchiveWriter.cs"
             LinkBase="Linked\Import" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\FaViewerStateReader.cs"
             LinkBase="Linked\Import" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\src\FabricationAssistant.Import.Gltf\FaViewerState\*.cs"
             LinkBase="Linked\Import\FaViewerState" />
  </ItemGroup>

  <!--
    Link the gesture recognizer + its geometry types so the desktop test suite
    can be ported and run on net8.0 host without Android tooling. We can't
    ProjectReference FabricationAssistant.Input.Gestures.Android (it targets
    net8.0-android34.0) so we link the small set of files instead.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Input.Gestures.Android\Point2D.cs"
             LinkBase="Linked\Gestures" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Input.Gestures.Android\Vector2D.cs"
             LinkBase="Linked\Gestures" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Input.Gestures.Android\TouchGestureEvent.cs"
             LinkBase="Linked\Gestures" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Input.Gestures.Android\AndroidCameraClipPlanes.cs"
             LinkBase="Linked\Gestures" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Input.Gestures.Android\ViewportTouchGestureRecognizer.cs"
             LinkBase="Linked\Gestures" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Input.Gestures.Android\ViewportInteractionAdapter.cs"
             LinkBase="Linked\Gestures" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\Measurement\AndroidSectionClipper.cs"
             LinkBase="Linked\Android.Measurement" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\Measurement\AndroidMeasureRaycaster.cs"
             LinkBase="Linked\Android.Measurement" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\Measurement\AndroidMeshRaycastAcceleration.cs"
             LinkBase="Linked\Android.Measurement" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\Measurement\AndroidSnapWarmupRunner.cs"
             LinkBase="Linked\Android.Measurement" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\AndroidPathComparer.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\AppSettingsValueGuards.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\AndroidModelSelectionResolver.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\CloudModels.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\CloudPasswordResetFlow.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\CloudServerUrls.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\Tools\AndroidViewportExplodeView.cs"
             LinkBase="Linked\Android.Tools" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\ImportFileTypeResolver.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\ImportFileSignatureValidator.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\ImportCacheFileName.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\RecentFileEntry.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\RecentFilesList.cs"
             LinkBase="Linked\Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.App.Android\RecentFilesPersistence.cs"
             LinkBase="Linked\Android" />
  </ItemGroup>

  <!--
    Link the partial-class file that contains MsaaSceneFramebuffer.ClampSamples
    into the test assembly so unit tests can exercise the pure-arithmetic path
    without pulling in the full FabricationAssistant.Rendering.Gles project
    (which targets net8.0-android and references Silk.NET.OpenGLES, neither of
    which can load in the net8.0 host test runner).
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Rendering.Gles\MsaaSceneFramebuffer.ClampSamples.cs"
             LinkBase="Linked\Rendering.Gles" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Rendering.Gles\SceneAppearance.cs"
             LinkBase="Linked\Rendering.Gles" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Draco.Android\DracoGltfTranscoder.cs"
             LinkBase="Linked\Draco.Android" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FabricationAssistant.Draco.Android\DracoNativeDecoder.cs"
             LinkBase="Linked\Draco.Android" />
  </ItemGroup>

</Project>
