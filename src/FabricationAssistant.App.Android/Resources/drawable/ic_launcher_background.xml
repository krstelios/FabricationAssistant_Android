<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit adaptive launcher background. Modern Android launchers can wrap
  non-adaptive transparent icons in a white tile, so the launcher icon uses the
  app shell surface color while the in-app toolbar mark remains transparent.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/md_theme_surface" />
</shape>
