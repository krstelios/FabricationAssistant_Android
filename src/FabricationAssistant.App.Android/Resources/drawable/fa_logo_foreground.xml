<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground for the Fabrication Assistant launcher icon. Mirrors the desktop
  icon.svg (teal hexagon outline + F glyph). Original SVG uses a 24x24 viewBox;
  we pad to 36x36 here so the icon sits within the inner safe zone (~67% of
  the 108dp adaptive icon area) and isn't clipped by launcher masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="36"
    android:viewportHeight="36">
    <group
        android:translateX="6"
        android:translateY="6">
        <!-- Hex outline -->
        <path
            android:pathData="M 12,1 L 22,6.5 L 22,17.5 L 12,23 L 2,17.5 L 2,6.5 Z"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.6"
            android:fillColor="#00000000" />
        <!-- F glyph: vertical bar -->
        <path
            android:pathData="M 9,7.5 L 9,16.5"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
        <!-- F glyph: top bar -->
        <path
            android:pathData="M 9,7.5 L 15,7.5"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
        <!-- F glyph: middle bar -->
        <path
            android:pathData="M 9,12 L 14,12"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
    </group>
</vector>
