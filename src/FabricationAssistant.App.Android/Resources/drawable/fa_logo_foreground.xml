<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground for the adaptive launcher icon. Mirrors the desktop icon.svg
  (teal hexagon outline + F glyph). The 24x24 artwork is padded inside a 36x36
  viewport so launcher masks have room to scale it without clipping the stroke.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="36"
    android:viewportHeight="36">
    <group
        android:translateX="6"
        android:translateY="6">
        <!-- Hex outline -->
        <path
            android:pathData="M 12,1 L 22,6.5 L 22,17.5 L 12,23 L 2,17.5 L 2,6.5 Z"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.6"
            android:fillColor="#00000000" />
        <!-- F glyph: vertical bar -->
        <path
            android:pathData="M 9,7.5 L 9,16.5"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
        <!-- F glyph: top bar -->
        <path
            android:pathData="M 9,7.5 L 15,7.5"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
        <!-- F glyph: middle bar -->
        <path
            android:pathData="M 9,12 L 14,12"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
    </group>
</vector>
