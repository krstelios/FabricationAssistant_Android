<?xml version="1.0" encoding="utf-8"?>
<!--
  FA Cloud is internet-only. CloudApiClient also requires https:// URLs, and the
  network layer blocks cleartext as a second guard.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
