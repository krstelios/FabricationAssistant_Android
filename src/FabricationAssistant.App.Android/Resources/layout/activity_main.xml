<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fa_app_background">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fa_app_bar_height"
        android:background="@color/fa_surface_background"
        app:logo="@drawable/fa_logo_toolbar"
        app:logoDescription="@string/app_name"
        app:title="@string/app_name"
        app:titleMarginStart="@dimen/fa_space_l"
        app:titleTextAppearance="@style/FA.TextAppearance.Title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cloudAccountButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/fa_space_s"
            android:contentDescription="@string/cd_cloud_account"
            app:icon="@drawable/ic_account_circle"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/propertiesToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/fa_space_s"
            android:contentDescription="@string/cd_toggle_properties"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/fa_space_s"
            android:contentDescription="@string/cd_save_model"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Left Navigation Rail -->
    <ScrollView
        android:id="@+id/navRail"
        android:layout_width="@dimen/fa_nav_rail_width"
        android:layout_height="0dp"
        android:background="@color/fa_nav_rail_background"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingTop="@dimen/fa_space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navOpenButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_open"
            app:icon="@drawable/ic_open_file"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navRecentButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_recent"
            app:icon="@drawable/ic_recent"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navCloudButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_cloud"
            app:icon="@drawable/ic_cloud"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navUndoButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_undo"
            app:icon="@drawable/ic_undo"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navRedoButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_redo"
            app:icon="@drawable/ic_redo"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navModelExplorerButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_model_explorer"
            app:icon="@drawable/ic_model_explorer"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navBomButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_bom"
            app:icon="@drawable/ic_bom_hierarchy"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navBomFlatButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginTop="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_bom_flat"
            app:icon="@drawable/ic_bom_flat"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSpenPalmButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginBottom="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_nav_spen_palm_rejection_off"
            app:icon="@drawable/ic_spen_palm_rejection"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSettingsButton"
            android:layout_width="@dimen/fa_nav_rail_item_width"
            android:layout_height="@dimen/fa_nav_rail_item_height"
            android:layout_marginBottom="@dimen/fa_space_s"
            android:contentDescription="@string/cd_nav_settings"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_nav_rail_item_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.IconButton" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/navRailDivider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:dividerColor="@color/fa_border"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintStart_toEndOf="@+id/navRail" />

    <!-- Left tool panel (collapsible, matches the right properties panel behavior) -->
    <FrameLayout
        android:id="@+id/leftToolPanel"
        android:layout_width="@dimen/fa_settings_panel_width"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@color/fa_app_background"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintStart_toEndOf="@+id/navRailDivider" />

    <FrameLayout
        android:id="@+id/leftToolPanelDivider"
        android:layout_width="@dimen/fa_panel_resize_handle_width"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintStart_toEndOf="@+id/leftToolPanel">

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="@dimen/fa_panel_resize_handle_line_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:dividerColor="@color/fa_border" />

    </FrameLayout>

    <!-- Center viewport -->
    <FrameLayout
        android:id="@+id/viewportContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fa_app_background"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintStart_toEndOf="@+id/leftToolPanelDivider"
        app:layout_constraintEnd_toStartOf="@+id/propertiesPanelDivider" />

    <!-- Right Properties Panel (collapsible) -->
    <FrameLayout
        android:id="@+id/propertiesPanelDivider"
        android:layout_width="@dimen/fa_panel_resize_handle_width"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintEnd_toStartOf="@+id/propertiesPanel">

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="@dimen/fa_panel_resize_handle_line_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            app:dividerColor="@color/fa_border" />

    </FrameLayout>

    <include
        android:id="@+id/propertiesPanel"
        layout="@layout/view_properties_panel"
        android:layout_width="@dimen/fa_properties_panel_width"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom AppBar -->
    <LinearLayout
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fa_bottom_bar_height"
        android:orientation="horizontal"
        android:background="@color/fa_surface_background"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/fa_space_s"
        android:paddingEnd="@dimen/fa_space_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:id="@+id/bottomToolScroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/bottomToolCluster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolSelect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_tool_select"
            app:icon="@drawable/ic_tool_select"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolMove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_move"
            app:icon="@drawable/ic_tool_move"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolZoomWindow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_zoom_window"
            app:icon="@drawable/ic_tool_zoom_window"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolZoomSelected"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_zoom_selected"
            app:icon="@drawable/ic_tool_zoom_selected"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolScanQr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_scan_qr"
            app:icon="@drawable/ic_tool_scan_qr"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolFitView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_fit_view"
            app:icon="@drawable/ic_tool_fit_view"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolViewPresets"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_view_presets"
            app:icon="@drawable/ic_view_presets"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolSections"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_section"
            app:icon="@drawable/ic_tool_sections"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolMeasure"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_measure"
            app:icon="@drawable/ic_measure"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolExplode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_explode"
            app:icon="@drawable/ic_tool_explode"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolHide"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_hide"
            app:icon="@drawable/ic_tool_hide"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolShowAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_show_all"
            app:icon="@drawable/ic_tool_show_all"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolIsolate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_isolate"
            app:icon="@drawable/ic_tool_isolate"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolIsolateXray"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_isolate_xray"
            app:icon="@drawable/ic_tool_isolate_xray"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolRenderModes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:contentDescription="@string/cd_tool_render_modes"
            app:icon="@drawable/ic_render_modes"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/measureBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:contentDescription="@string/cd_measure_return"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/measurePointToPoint"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:visibility="gone"
            android:contentDescription="@string/cd_measure_point_to_point"
            app:icon="@drawable/ic_measure_point"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/measureFaceToPoint"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/fa_space_xs"
            android:visibility="gone"
            android:contentDescription="@string/cd_measure_face_to_point"
            app:icon="@drawable/ic_measure_face_point"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/fa_viewport_toolbar_icon_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/FA.ViewportToolbarIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/measureFaceToFace"
